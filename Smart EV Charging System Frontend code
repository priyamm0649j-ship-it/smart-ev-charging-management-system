async function createStation(event) {
  event.preventDefault();
  const values = Object.fromEntries(new FormData(event.currentTarget).entries());
  values.max_power_kw = Number(values.max_power_kw);
  const result = await runAction(() => fetchAPI("/api/admin/stations", { method: "POST", body: JSON.stringify(values) }), "Station created.");
  if (!result) return;
  event.currentTarget.reset();
  await loadAdmin();
}

async function createCharger(event) {
  event.preventDefault();
  const values = Object.fromEntries(new FormData(event.currentTarget).entries());
  const stationId = values.station_id;
  delete values.station_id;
  values.max_power_kw = Number(values.max_power_kw);
  values.price_per_kwh = Number(values.price_per_kwh);
  const result = await runAction(() => fetchAPI(`/api/admin/stations/${stationId}/chargers`, { method: "POST", body: JSON.stringify(values) }), "Charger added.");
  if (!result) return;
  event.currentTarget.reset();
  await loadAdmin();
}

async function toggleStation(stationId) {
  const station = state.managedStations.find(item => item.id === Number(stationId));
  if (!station) return;
  const updated = await runAction(() => fetchAPI(`/api/admin/stations/${station.id}`, { method: "PATCH", body: JSON.stringify({ active: !station.active }) }), `Station ${station.active ? "paused" : "activated"}.`);
  if (!updated) return;
  state.managedStations = [...state.managedStations.filter(item => item.id !== updated.id), updated];
  localStorage.setItem("chargeflowStations", JSON.stringify(state.managedStations));
  await loadAdmin();
}

async function updateChargerStatus(chargerId, status) {
  const result = await runAction(() => fetchAPI(`/api/admin/chargers/${chargerId}`, { method: "PATCH", body: JSON.stringify({ status }) }), "Charger status updated.");
  if (result) await loadAdmin();
}

async function changeSessionStatus(bookingId, action) {
  let body;
  if (action === "complete") {
    const energy = window.prompt("Enter energy delivered in kWh. Leave the suggested value to use the estimate:");
    if (energy === null) return;
    body = JSON.stringify({ energy_kwh: Number(energy) });
  }
  const result = await runAction(() => fetchAPI(`/api/admin/bookings/${bookingId}/${action}`, { method: "POST", ...(body ? { body } : {}) }), action === "start" ? "Charging session started." : "Session completed. Payment is recorded as simulation only.");
  if (result) await loadAdmin();
}

async function runSimulation(event) {
  event.preventDefault();
  const form = new FormData(event.currentTarget);
  const arrivals = String(form.get("arrivals")).trim().split(/\n+/).map((line, index) => {
    const [connectorType, capacity, power, battery, target, emergency] = line.split(",").map(value => value.trim());
    return {
      connector_type: connectorType,
      battery_capacity_kwh: Number(capacity),
      max_charging_power_kw: Number(power),
      battery_percent: Number(battery),
      target_percent: Number(target),
      emergency: emergency?.toLowerCase() === "true",
      arrival_offset_minutes: index
    };
  });
  const result = await runAction(() => fetchAPI("/api/simulation/what-if", {
    method: "POST",
    body: JSON.stringify({ station_id: Number(form.get("station_id")), arrivals })
  }));
  if (!result) return;
  state.simulationResult = result;
  renderSimulationResult(result);
}

function renderSimulationResult(result) {
  const heading = result.would_exceed_power_limit ? "Power limit exceeded" : "Within power limit";
  const tone = result.would_exceed_power_limit ? "red" : "green";
  const rows = result.results.map(item => `<tr><td>Arrival #${item.arrival_id}</td><td>${statusBadge(item.status)}</td><td>${item.priority_level > 1 ? "Urgent" : item.priority_level === 1 ? "Low battery" : "Standard"}</td><td>${escapeHTML(item.suggested_charger?.name || "None available")}</td><td>${item.estimated_energy_kwh} kWh · ${item.estimated_minutes ?? "—"} min · ${formatMoney(item.estimated_cost)}</td></tr>`).join("");
  document.getElementById("simulation-result").innerHTML = `<div class="section-heading"><div><p class="eyebrow">SIMULATION RESULT · PYTHON SCHEDULER</p><h2>Dispatch preview</h2></div><span class="badge ${tone}">${heading}</span></div><div class="sim-summary"><span><small>Dispatch order</small><b>${result.dispatch_order.map(id => `#${id}`).join(" → ")}</b></span><span><small>Projected load</small><b>${result.projected_committed_power_kw} / ${result.station_max_power_kw} kW</b></span></div><div class="table-wrap"><table><thead><tr><th>ARRIVAL</th><th>STATUS</th><th>PRIORITY</th><th>CHARGER</th><th>EST. CHARGE</th></tr></thead><tbody>${rows}</tbody></table></div><p class="form-help">${escapeHTML(result.note || "Snapshot only. It does not create bookings.")}</p>`;
}

function attachEventHandlers() {
  document.addEventListener("click", event => {
    const pageButton = event.target.closest("[data-page]");
    if (pageButton) { event.preventDefault(); openPage(pageButton.dataset.page); return; }
    const topAuthButton = event.target.closest("#top-auth-button");
    if (event.target.closest("[data-sign-out]") || topAuthButton?.textContent === "Sign out") { signOut(); return; }
    if (topAuthButton) { openPage("auth"); return; }
    const authModeButton = event.target.closest("[data-auth-mode]");
    if (authModeButton) { setAuthMode(authModeButton.dataset.authMode); return; }
    const bookButton = event.target.closest("[data-book-station]");
    if (bookButton) {
      if (!state.user) { openPage("auth"); return; }
      openPage("bookings");
      document.querySelector('#booking-form select[name="station_id"]').value = bookButton.dataset.bookStation;
      if (state.vehicles[0]) document.querySelector('#booking-form select[name="vehicle_id"]').value = state.vehicles[0].id;
      return;
    }
    const cancelButton = event.target.closest("[data-cancel-booking]");
    if (cancelButton) { cancelBooking(cancelButton.dataset.cancelBooking); return; }
    const stationButton = event.target.closest("[data-station-toggle]");
    if (stationButton) { toggleStation(stationButton.dataset.stationToggle); return; }
    const sessionButton = event.target.closest("[data-session-action]");
    if (sessionButton) { changeSessionStatus(sessionButton.dataset.id, sessionButton.dataset.sessionAction); return; }
    if (event.target.id === "confirm-booking") confirmBooking();
    if (event.target.closest(".alert button")) setMessage("");
  });

  document.addEventListener("change", event => {
    if (event.target.id === "connector-filter") renderStations(state.stations);
    if (event.target.matches("[data-charger-status]")) updateChargerStatus(event.target.dataset.chargerStatus, event.target.value);
  });
  document.getElementById("station-search").addEventListener("input", () => renderStations(state.stations));
  document.getElementById("auth-form").addEventListener("submit", submitAuth);
  document.getElementById("vehicle-form").addEventListener("submit", submitVehicle);
  document.getElementById("booking-form").addEventListener("submit", requestQuote);
  document.getElementById("vehicle-form").addEventListener("reset", () => setTimeout(updateVehicleSelect, 0));
  document.getElementById("station-create-form").addEventListener("submit", createStation);
  document.getElementById("charger-create-form").addEventListener("submit", createCharger);
  document.getElementById("simulation-form").addEventListener("submit", runSimulation);
}

async function restoreLogin() {
  if (!state.token) return;
  try {
    const user = await fetchAPI("/api/auth/me");
    state.user = user;
    localStorage.setItem("chargeflowUser", JSON.stringify(user));
    updateAccountUI();
    updateRoleNavigation();
  } catch {
    state.token = "";
    state.user = null;
    localStorage.removeItem("chargeflowToken");
    localStorage.removeItem("chargeflowUser");
    updateAccountUI();
    updateRoleNavigation();
  }
}

async function startFrontend() {
  attachEventHandlers();
  setAuthMode("login");
  updateAccountUI();
  updateRoleNavigation();
  fillFormOptions();
  await Promise.all([checkAPI(), restoreLogin()]);
  if (state.user) {
    try { await loadUserData(); } catch (error) { setMessage(error.message, "error"); }
  }
  openPage("dashboard");
}

document.addEventListener("DOMContentLoaded", startFrontend);

</script>
