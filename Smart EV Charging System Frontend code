  <script>
const API_BASE_URL = "http://127.0.0.1:5000";
const state = {
  token: localStorage.getItem("chargeflowToken") || "",
  user: readStoredUser(),
  stations: [],
  managedStations: readStoredStations(),
  vehicles: [],
  bookings: [],
  history: [],
  adminDashboard: null,
  adminBookings: [],
  adminHistory: [],
  authMode: "login",
  quote: null,
  simulationResult: null,
  currentPage: "dashboard"
};

const pageNames = {
  dashboard: "Dashboard", auth: "Driver portal", stations: "Charging stations",
  vehicles: "My vehicles", bookings: "Book a session", history: "Charge history",
  admin: "Admin console", simulation: "What-if simulator"
};

function readStoredUser() {
  try { return JSON.parse(localStorage.getItem("chargeflowUser") || "null"); }
  catch { return null; }
}

function readStoredStations() {
  try { return JSON.parse(localStorage.getItem("chargeflowStations") || "[]"); }
  catch { return []; }
}

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, character => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
  })[character]);
}

function formatMoney(value) {
  return value == null ? "—" : `₹${Number(value).toFixed(2)}`;
}

function formatNumber(value, decimals = 1) {
  return Number(value || 0).toFixed(decimals);
}

function titleCase(value) {
  return String(value || "").replaceAll("_", " ").replace(/\b\w/g, letter => letter.toUpperCase());
}

function setMessage(message, kind = "success") {
  const area = document.getElementById("message-area");
  if (!message) { area.innerHTML = ""; return; }
  area.innerHTML = `<div class="alert ${kind}"><b>${kind === "error" ? "!" : "✓"}</b><span>${escapeHTML(message)}</span><button type="button" aria-label="Dismiss">×</button></div>`;
}

function setLoading(isLoading) {
  document.getElementById("loading-indicator").classList.toggle("hidden", !isLoading);
}

async function fetchAPI(path, options = {}) {
  const headers = { ...(options.body ? { "Content-Type": "application/json" } : {}), ...(options.headers || {}) };
  if (options.auth !== false && state.token) headers.Authorization = `Bearer ${state.token}`;
  let response;
  try {
    response = await fetch(`${API_BASE_URL}${path}`, { ...options, headers });
  } catch {
    throw new Error(`Cannot reach the backend at ${API_BASE_URL}. Start Flask and check the API address.`);
  }
  if (response.status === 204) return null;
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.error || `The request failed (${response.status}).`);
  return data;
}

async function runAction(action, successMessage) {
  setLoading(true);
  try {
    const result = await action();
    if (successMessage) setMessage(successMessage);
    return result;
  } catch (error) {
    setMessage(error.message, "error");
    return null;
  } finally {
    setLoading(false);
  }
}

function setAPIStatus(status) {
  const element = document.getElementById("api-status");
  element.classList.remove("online", "offline");
  if (status === true) { element.classList.add("online"); element.lastChild.textContent = " API online"; }
  else if (status === false) { element.classList.add("offline"); element.lastChild.textContent = " API offline"; }
  else element.lastChild.textContent = " Checking API";
}

async function checkAPI() {
  try { await fetchAPI("/api/health", { auth: false }); setAPIStatus(true); }
  catch { setAPIStatus(false); }
}

function saveUserSession(token, user) {
  state.token = token;
  state.user = user;
  localStorage.setItem("chargeflowToken", token);
  localStorage.setItem("chargeflowUser", JSON.stringify(user));
  updateAccountUI();
}

function signOut() {
  state.token = "";
  state.user = null;
  state.vehicles = [];
  state.bookings = [];
  state.history = [];
