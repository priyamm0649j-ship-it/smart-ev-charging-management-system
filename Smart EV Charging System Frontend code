  if (!bookings) return;
  state.bookings = bookings;
  renderBookings(bookings, document.getElementById("booking-list"), false);
}

function renderBookings(bookings, container, isAdmin) {
  if (!bookings.length) { container.innerHTML = emptyState("No bookings yet", "Your charging requests will appear here."); return; }
  const rows = bookings.map(booking => {
    const priority = booking.emergency ? `<span class="badge red">Urgent</span>` : booking.priority_level > 0 ? `<span class="badge amber">Low battery</span>` : `<span class="muted">Standard</span>`;
    const queue = booking.queue_position == null ? "—" : `#${booking.queue_position} · ${booking.estimated_wait_minutes ?? "—"} min`;
    let action = "";
    if (isAdmin && booking.status === "assigned") action = `<button class="table-action" data-session-action="start" data-id="${booking.id}">Start</button>`;
    else if (isAdmin && booking.status === "charging") action = `<button class="table-action" data-session-action="complete" data-id="${booking.id}">Complete</button>`;
    else if (!isAdmin && ["waiting", "assigned"].includes(booking.status)) action = `<button class="table-action danger" data-cancel-booking="${booking.id}">Cancel</button>`;
    return `<tr><td><b>Booking #${booking.id}</b><small>Station ${booking.station_id} · Vehicle ${booking.vehicle_id}</small></td><td>${statusBadge(booking.status)}</td><td>${priority}</td><td>${queue}</td><td><b>${formatMoney(booking.estimated_cost)}</b><small>${booking.estimated_energy_kwh} kWh · ${booking.estimated_minutes} min</small></td><td>${action}</td></tr>`;
  }).join("");
  container.innerHTML = `<div class="table-wrap"><table><thead><tr><th>REQUEST</th><th>STATUS</th><th>PRIORITY</th><th>QUEUE / WAIT</th><th>EST. CHARGE</th><th>ACTION</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}

async function loadHistory() {
  const sessions = await runAction(() => fetchAPI("/api/sessions/history"));
  if (!sessions) return;
  state.history = sessions;
  renderHistory();
}

function renderHistory() {
  const sessions = state.history;
  const totalEnergy = sessions.reduce((sum, session) => sum + Number(session.energy_kwh || 0), 0);
  const totalCost = sessions.reduce((sum, session) => sum + Number(session.cost || 0), 0);
  document.getElementById("history-stats").innerHTML = [
    ["↗", "Total sessions", sessions.length, "Recorded sessions"],
    ["ϟ", "Energy delivered", `${formatNumber(totalEnergy)} kWh`, "From session records"],
    ["₹", "Recorded spend", formatMoney(totalCost), "Simulated payment records"]
  ].map(statCard).join("");
  const container = document.getElementById("history-list");
  if (!sessions.length) { container.innerHTML = emptyState("No charging sessions yet", "A record appears after an administrator starts a session."); return; }
  const rows = sessions.map(session => `<tr><td><b>Session #${session.session_id}</b><small>Booking #${session.booking_id}</small></td><td>Station ${session.station_id}</td><td>${escapeHTML(new Date(session.started_at).toLocaleString())}</td><td>${session.energy_kwh == null ? "In progress" : `${formatNumber(session.energy_kwh, 2)} kWh`}</td><td>${formatMoney(session.cost)}</td><td>${session.payment ? statusBadge(session.payment.status) : "—"}</td></tr>`).join("");
  container.innerHTML = `<div class="table-wrap"><table><thead><tr><th>SESSION</th><th>STATION</th><th>STARTED</th><th>ENERGY</th><th>COST</th><th>PAYMENT</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}

