}

function fillFormOptions() {
  updateStationSelects();
  updateVehicleSelect();
}

async function submitAuth(event) {
  event.preventDefault();
  const form = new FormData(event.currentTarget);
  const payload = { email: form.get("email"), password: form.get("password") };
  if (state.authMode === "register") payload.name = form.get("name");
  const route = state.authMode === "login" ? "/api/auth/login" : "/api/auth/register";
  const result = await runAction(() => fetchAPI(route, { method: "POST", body: JSON.stringify(payload), auth: false }));
  if (!result) return;
  saveUserSession(result.access_token, result.user);
  updateRoleNavigation();
  openPage("dashboard");
  setMessage(state.authMode === "login" ? "Welcome back." : "Your account is ready.");
}

function setAuthMode(mode) {
  state.authMode = mode;
  const isRegister = mode === "register";
  document.getElementById("auth-title").textContent = isRegister ? "Create your account" : "Welcome back";
  document.getElementById("auth-subtitle").textContent = isRegister ? "Set up your EV charging profile." : "Sign in to manage your charging.";
  document.getElementById("auth-name-row").classList.toggle("hidden", !isRegister);
  document.querySelector('#auth-form input[name="name"]').required = isRegister;
  document.querySelector('#auth-form input[name="password"]').autocomplete = isRegister ? "new-password" : "current-password";
  document.getElementById("auth-submit").textContent = isRegister ? "Create account →" : "Sign in →";
  document.querySelectorAll(".auth-tab").forEach(button => button.classList.toggle("selected", button.dataset.authMode === mode));
}

async function submitVehicle(event) {
  event.preventDefault();
  const values = Object.fromEntries(new FormData(event.currentTarget).entries());
  values.battery_capacity_kwh = Number(values.battery_capacity_kwh);
  values.max_charging_power_kw = Number(values.max_charging_power_kw);
  const result = await runAction(() => fetchAPI("/api/vehicles", { method: "POST", body: JSON.stringify(values) }), "Vehicle added.");
  if (!result) return;
  event.currentTarget.reset();
  await loadVehicles();
}

function getBookingValues() {
  const values = Object.fromEntries(new FormData(document.getElementById("booking-form")).entries());
  values.vehicle_id = Number(values.vehicle_id);
  values.station_id = Number(values.station_id);
  values.battery_percent = Number(values.battery_percent);
  values.target_percent = Number(values.target_percent);
  values.emergency = document.querySelector('#booking-form input[name="emergency"]').checked;
