function updateRoleNavigation() {
  document.querySelectorAll(".requires-login").forEach(element => element.classList.toggle("hidden", !state.user));
  document.querySelectorAll(".admin-nav").forEach(element => element.classList.toggle("hidden", state.user?.role !== "admin"));
}

function openPage(page) {
  if (["vehicles", "bookings", "history"].includes(page) && !state.user) page = "auth";
  if (["admin", "simulation"].includes(page) && state.user?.role !== "admin") page = state.user ? "admin" : "auth";
  state.currentPage = page;
  document.querySelectorAll(".page").forEach(section => section.classList.remove("active"));
  document.getElementById(`page-${page}`).classList.add("active");
  document.querySelectorAll(".nav-link[data-page]").forEach(button => button.classList.toggle("active", button.dataset.page === page));
  document.getElementById("current-page-name").textContent = pageNames[page] || "Dashboard";
  setMessage("");
  if (page === "dashboard") refreshDashboard();
  if (page === "stations") loadStations();
  if (page === "vehicles") loadVehicles();
  if (page === "bookings") { loadVehicles(); loadStations(); loadBookings(); }
  if (page === "history") loadHistory();
  if (page === "admin") loadAdmin();
  if (page === "simulation") loadStations();
}

async function loadStations() {
  const stations = await runAction(() => fetchAPI("/api/stations", { auth: false }));
  if (!stations) { renderStations([]); return; }
  state.stations = stations;
  mergeManagedStations(stations);
  renderStations(stations);
  updateStationSelects();
}

function mergeManagedStations(activeStations) {
  const activeIds = activeStations.map(station => station.id);
  const pausedStations = state.managedStations.filter(station => !station.active && !activeIds.includes(station.id));
  state.managedStations = [...pausedStations, ...activeStations];
  localStorage.setItem("chargeflowStations", JSON.stringify(state.managedStations));
}

function renderStations(stations) {
  const search = document.getElementById("station-search").value.trim().toLowerCase();
  const selectedConnector = document.getElementById("connector-filter").value;
  const visible = stations.filter(station => {
    const matchesName = `${station.name} ${station.address}`.toLowerCase().includes(search);
    const matchesConnector = selectedConnector === "all" || station.chargers.some(charger => charger.connector_type === selectedConnector);
    return matchesName && matchesConnector;
  });
  const connectors = [...new Set(stations.flatMap(station => station.chargers.map(charger => charger.connector_type)))];
  const filter = document.getElementById("connector-filter");
  const oldChoice = filter.value;
  filter.innerHTML = `<option value="all">All connectors</option>${connectors.map(value => `<option value="${escapeHTML(value)}">${escapeHTML(value)}</option>`).join("")}`;
  filter.value = connectors.includes(oldChoice) ? oldChoice : "all";
  document.getElementById("station-count").textContent = `${visible.length} ${visible.length === 1 ? "station" : "stations"}`;
  const container = document.getElementById("station-list");
  if (!visible.length) {
    container.innerHTML = emptyState("No matching stations", "Try another search or connector. This list only shows stations returned by the backend.");
    return;
  }
  container.innerHTML = visible.map(station => {
    const ready = station.chargers.filter(charger => charger.status === "available").length;
    const loadPercent = station.max_power_kw ? Math.min(100, station.committed_power_kw / station.max_power_kw * 100) : 0;
    const chargerRows = station.chargers.map(charger => `<div class="charger-item"><div class="charger-primary"><b>${escapeHTML(charger.name)}</b><small>${escapeHTML(charger.connector_type)} · ${escapeHTML(charger.max_power_kw)} kW</small></div><div class="charger-side"><b>${formatMoney(charger.price_per_kwh)}<small> / kWh</small></b>${statusBadge(charger.status)}</div></div>`).join("");
    return `<article class="station-card"><div class="station-top"><span class="station-icon">ϟ</span>${ready ? `<span class="badge green">${ready} available</span>` : `<span class="badge amber">No free units</span>`}</div><h3>${escapeHTML(station.name)}</h3><p class="station-address">⌖　${escapeHTML(station.address)}</p><div class="charger-list">${chargerRows || `<small class="muted">No charger units configured.</small>`}</div><div class="load-line"><span>Station load</span><b>${formatNumber(station.committed_power_kw)} / ${formatNumber(station.max_power_kw)} kW</b></div><div class="load-track"><span style="width:${loadPercent}%"></span></div><div class="station-foot"><small>${formatNumber(station.available_power_kw)} kW available capacity</small><button class="button button-primary button-small" data-book-station="${station.id}">Book →</button></div></article>`;
  }).join("");
  document.getElementById("station-count").textContent = `${visible.length} ${visible.length === 1 ? "station" : "stations"}`;
}

function statusBadge(status) {
  const tone = { available: "green", fault: "red", reserved: "blue", charging: "blue", waiting: "amber", assigned: "green", completed: "green", cancelled: "gray" }[status] || "gray";
  return `<span class="badge ${tone}">${escapeHTML(titleCase(status))}</span>`;
}

function emptyState(heading, message) {
  return `<div class="empty-state"><span>↗</span><h3>${escapeHTML(heading)}</h3><p>${escapeHTML(message)}</p></div>`;
}

async function refreshDashboard() {
  const jobs = [loadStationsForDashboard()];
  if (state.user) jobs.push(loadUserData());
  if (state.user?.role === "admin") jobs.push(loadAdminData());
  try { await Promise.all(jobs); }
  catch (error) { setMessage(error.message, "error"); }
  renderDashboard();
}

async function loadStationsForDashboard() {
  try {
    state.stations = await fetchAPI("/api/stations", { auth: false });
    mergeManagedStations(state.stations);
  } catch (error) { setMessage(error.message, "error"); state.stations = []; }
}

async function loadUserData() {
  const [vehicles, bookings, history] = await Promise.all([
    fetchAPI("/api/vehicles"), fetchAPI("/api/bookings"), fetchAPI("/api/sessions/history")
  ]);
  state.vehicles = vehicles;
  state.bookings = bookings;
  state.history = history;
}

async function renderDashboard() {
  const activeBookings = state.bookings.filter(booking => ["waiting", "assigned", "charging"].includes(booking.status));
  const completedSessions = state.history.filter(session => session.status === "completed");
  const energy = completedSessions.reduce((sum, session) => sum + Number(session.energy_kwh || 0), 0);
  const chargerCount = state.stations.reduce((sum, station) => sum + station.chargers.length, 0);
  const stats = state.user ? [
    ["⌖", "Active stations", state.stations.length, "Ready to explore"],
    ["◷", "Open requests", activeBookings.length, "Your queue activity"],
    ["▱", "My vehicles", state.vehicles.length, "Saved EV profiles"],
    ["↗", "Energy delivered", `${formatNumber(energy)} kWh`, `${completedSessions.length} completed sessions`]
  ] : [
    ["⌖", "Active stations", state.stations.length, "Fetched from the API"],
    ["ϟ", "Charger units", chargerCount, "By connector type"],
    ["◉", "Power aware", "On", "Station limits respected"],
    ["⌁", "Queue logic", "Smart", "Priority and wait estimates"]
  ];
  document.getElementById("dashboard-stats").innerHTML = stats.map(statCard).join("");
  const adminSummary = document.getElementById("admin-summary");
  if (state.user?.role === "admin" && state.adminDashboard) {
    adminSummary.classList.remove("hidden");
    adminSummary.innerHTML = `<div class="section-heading"><div><p class="eyebrow">ADMIN SNAPSHOT</p><h2>Station operations</h2></div><button class="text-button" data-page="admin">Open admin console →</button></div><div class="mini-row"><span><b>${state.adminDashboard.waiting_bookings}</b> waiting</span><span><b>${state.adminDashboard.assigned_bookings}</b> assigned</span><span><b>${state.adminDashboard.active_sessions}</b> charging now</span></div>`;
  } else adminSummary.classList.add("hidden");
}

function statCard([icon, label, value, detail]) {
  return `<article class="stat-card"><span class="stat-icon">${escapeHTML(icon)}</span><small class="stat-label">${escapeHTML(label)}</small><strong>${escapeHTML(value)}</strong><span class="stat-detail">${escapeHTML(detail)}</span></article>`;
}

