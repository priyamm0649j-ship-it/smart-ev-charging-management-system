bookings_bp = Blueprint("bookings", __name__, url_prefix="/api/bookings")
def _validated_request(data, owner_id=None):
    try:
        vehicle_id = int(data["vehicle_id"])
        station_id = int(data["station_id"])
        battery = float(data["battery_percent"])
        target = float(data["target_percent"])
    except (KeyError, TypeError, ValueError):
        return None, ("vehicle_id, station_id, battery_percent, and target_percent are required", 400)
    if not 0 <= battery < 100 or not battery < target <= 100:
        return None, ("Battery must be 0-99.99 and target must be above battery and at most 100", 400)
    if not math.isfinite(battery) or not math.isfinite(target):
        return None, ("Battery values must be finite numbers", 400)
    vehicle_query = Vehicle.query.filter_by(id=vehicle_id)
    if owner_id is not None:
        vehicle_query = vehicle_query.filter_by(owner_id=owner_id)
    vehicle = vehicle_query.first()
    if vehicle is None:
        return None, ("Vehicle not found", 404)
    station = Station.query.filter_by(id=station_id, active=True).first()
    if station is None:
        return None, ("Active station not found", 404)
    chargers = Charger.query.filter_by(station_id=station.id).all()
    candidates = [_charger_candidate(charger, station, committed_power_kw(station.id)) for charger in chargers]
    quote = _quote_charger(vehicle, battery, target, candidates)
    if quote is None:
        return None, ("This station has no working charger compatible with the vehicle", 422)
    emergency = data.get("emergency", False)
    if not isinstance(emergency, bool):
        return None, ("emergency must be true or false", 400)
    return {
        "vehicle": vehicle,
        "station": station,
        "battery": battery,
        "target": target,
        "emergency": emergency,
        "quote_charger": next(charger for charger in chargers if charger.id == quote["id"]),
    }, None
def _payload(booking):
    position, wait = queue_estimate(booking)
    return booking_json(booking, queue_position=position, estimated_wait_minutes=wait)
