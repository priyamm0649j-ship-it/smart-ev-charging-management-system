POWER_COMMITTED_STATUSES = ("reserved", "charging")
def priority_for(battery_percent, emergency):
    if emergency:
        return 2
    return 1 if battery_percent <= 20 else 0
def energy_needed_kwh(vehicle, battery_percent, target_percent):
    return vehicle.battery_capacity_kwh * max(0.0, target_percent - battery_percent) / 100.0
def estimate_charge(vehicle, battery_percent, target_percent, charger):
    energy = energy_needed_kwh(vehicle, battery_percent, target_percent)
    charging_power = min(vehicle.max_charging_power_kw, charger.max_power_kw)
    minutes = math.ceil(energy / charging_power * 60.0) if charging_power > 0 else 0
    return energy, minutes, energy * charger.price_per_kwh
def committed_power_kw(station_id):
    rows = Charger.query.filter_by(station_id=station_id).filter(Charger.status.in_(POWER_COMMITTED_STATUSES)).all()
    return sum(charger.max_power_kw for charger in rows)
def _charger_candidate(charger, station, load_kw):
    return {
        "id": charger.id,
        "connector_type": charger.connector_type,
        "max_power_kw": charger.max_power_kw,
        "price_per_kwh": charger.price_per_kwh,
        "committed_power_kw": load_kw,
        "station_max_power_kw": station.max_power_kw,
        "available": charger.status == "available",
        "status": charger.status,
    }
def _scheduler_request(booking):
    created = booking.created_at.replace(tzinfo=timezone.utc).timestamp()
    return {
        "id": booking.id,
        "priority": booking.priority_level,
        "battery_percent": booking.battery_percent,
        "created_at_epoch": int(created),
    }
def _need(vehicle, battery_percent, target_percent):
    return {
        "connector_type": vehicle.connector_type,
        "battery_percent": battery_percent,
        "target_percent": target_percent,
        "capacity_kwh": vehicle.battery_capacity_kwh,
        "vehicle_max_power_kw": vehicle.max_charging_power_kw,
    }
def _quote_charger(vehicle, battery, target, candidates):
    compatible = [
        item for item in candidates
        if item["connector_type"].casefold() == vehicle.connector_type.casefold() and item["status"] != "fault"
    ]
    if not compatible:
        return None
    energy = energy_needed_kwh(vehicle, battery, target)
    def score(item):
        power = min(item["max_power_kw"], vehicle.max_charging_power_kw)
        minutes = energy / power * 60.0 if power > 0 else float("inf")
        cost = energy * item["price_per_kwh"]
        load = (item["committed_power_kw"] + item["max_power_kw"]) / max(item["station_max_power_kw"], 0.001)
        return (minutes + 2.0 * cost + 15.0 * load, item["id"])
    return min(compatible, key=score)
def dispatch_waiting_bookings(station_id):
    station = Station.query.filter_by(id=station_id).with_for_update().first()
    if station is None or not station.active:
        return
    waiting = Booking.query.filter_by(station_id=station_id, status="waiting").all()
    ordered = sort_requests([_scheduler_request(item) for item in waiting])
    by_id = {item.id: item for item in waiting}
    chargers = Charger.query.filter_by(station_id=station_id).all()
    load_kw = committed_power_kw(station_id)
    for request in ordered:
        booking = by_id[request["id"]]
        candidate_rows = [_charger_candidate(charger, station, load_kw) for charger in chargers]
        chosen_index = choose_charger(
            _need(booking.vehicle, booking.battery_percent, booking.target_percent), candidate_rows
        )
        if chosen_index >= 0:
            charger = chargers[chosen_index]
            energy, minutes, cost = estimate_charge(
                booking.vehicle, booking.battery_percent, booking.target_percent, charger
            )
            booking.charger_id = charger.id
            booking.status = "assigned"
            booking.assigned_at = utcnow()
            booking.estimated_energy_kwh = energy
            booking.estimated_minutes = minutes
            booking.estimated_cost = cost
            charger.status = "reserved"
            load_kw += charger.max_power_kw
            continue
        quoted = _quote_charger(
            booking.vehicle,
            booking.battery_percent,
            booking.target_percent,
            [_charger_candidate(charger, station, load_kw) for charger in chargers],
        )
        if quoted:
            charger = next(item for item in chargers if item.id == quoted["id"])
            energy, minutes, cost = estimate_charge(
                booking.vehicle, booking.battery_percent, booking.target_percent, charger
            )
            booking.estimated_energy_kwh = energy
            booking.estimated_minutes = minutes
            booking.estimated_cost = cost
    db.session.flush()
def queue_estimate(booking):
    if booking.status != "waiting":
        return 0, 0
    queue = Booking.query.filter_by(station_id=booking.station_id, status="waiting").all()
    ordered = sort_requests([_scheduler_request(item) for item in queue])
    by_id = {item.id: item for item in queue}
    station = booking.station
    compatible_chargers = [
        charger for charger in station.chargers
        if charger.connector_type.casefold() == booking.vehicle.connector_type.casefold() and charger.status != "fault"
    ]
    compatible_queue = [
        by_id[item["id"]] for item in ordered
        if by_id[item["id"]].vehicle.connector_type.casefold() == booking.vehicle.connector_type.casefold()
    ]
    position = next((i + 1 for i, item in enumerate(compatible_queue) if item.id == booking.id), 0)
    if not compatible_chargers or position == 0:
        return position, 0
    now = utcnow()
    finish_times = []
    for charger in compatible_chargers:
        if charger.status == "available":
            finish_times.append(0)
            continue
        active_booking = Booking.query.filter_by(charger_id=charger.id, status="assigned").first()
        if charger.status == "reserved" and active_booking:
            finish_times.append(max(0, active_booking.estimated_minutes))
            continue
        session = ChargingSession.query.filter_by(charger_id=charger.id, status="charging").first()
        if session:
            elapsed = max(0.0, (now - session.started_at).total_seconds() / 60.0)
            finish_times.append(max(0, math.ceil(session.booking.estimated_minutes - elapsed)))
        else:
            finish_times.append(0)
    heapq.heapify(finish_times)
    for earlier in compatible_queue[: position - 1]:
        next_free = heapq.heappop(finish_times)
        heapq.heappush(finish_times, next_free + max(0, earlier.estimated_minutes))
    return position, max(0, int(math.ceil(min(finish_times))))
auth_bp = Blueprint("auth", __name__, url_prefix="/api/auth")
@auth_bp.post("/register")
def register():
    data = request.get_json(silent=True) or {}
    name_value = data.get("name")
    email_value = data.get("email")
    name = name_value.strip() if isinstance(name_value, str) else ""
    email = email_value.strip().lower() if isinstance(email_value, str) else ""
    password = data.get("password", "")
    if not name or not email or not isinstance(password, str):
        return jsonify({"error": "name, email, and password are required"}), 400
    if not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email):
        return jsonify({"error": "Enter a valid email address"}), 400
    if len(password) < 8:
        return jsonify({"error": "Password must contain at least 8 characters"}), 400
    user = User(name=name, email=email, password_hash=generate_password_hash(password), role="user")
    db.session.add(user)
    try:
        db.session.commit()
    except IntegrityError:
        db.session.rollback()
        return jsonify({"error": "An account with that email already exists"}), 409
    token = create_access_token(identity=str(user.id))
    return jsonify({"access_token": token, "user": {"id": user.id, "name": user.name, "email": user.email, "role": user.role}}), 201
@auth_bp.post("/login")
def login():
    data = request.get_json(silent=True) or {}
    email = str(data.get("email", "")).strip().lower()
    password = data.get("password", "")
    user = User.query.filter_by(email=email).first()
    if user is None or not isinstance(password, str) or not user.check_password(password):
        return jsonify({"error": "Invalid email or password"}), 401
    return jsonify({
        "access_token": create_access_token(identity=str(user.id)),
        "user": {"id": user.id, "name": user.name, "email": user.email, "role": user.role},
    })
@auth_bp.get("/me")
@jwt_required()
def me():
    user = current_user()
    if user is None:
        return jsonify({"error": "Account not found"}), 404
    return jsonify({"id": user.id, "name": user.name, "email": user.email, "role": user.role})
vehicles_bp = Blueprint("vehicles", __name__, url_prefix="/api/vehicles")
def _vehicle_values(data):
    try:
        name = data.get("name")
        registration = data.get("registration_number")
        connector = data.get("connector_type")
        values = {
            "name": name.strip() if isinstance(name, str) else "",
            "registration_number": registration.strip() or None if isinstance(registration, str) else None,
            "battery_capacity_kwh": float(data["battery_capacity_kwh"]),
            "connector_type": connector.strip() if isinstance(connector, str) else "",
            "max_charging_power_kw": float(data["max_charging_power_kw"]),
        }
    except (KeyError, TypeError, ValueError):
        return None, "battery_capacity_kwh and max_charging_power_kw must be numbers"
    if not values["name"] or not values["connector_type"]:
        return None, "name and connector_type are required"
    if not math.isfinite(values["battery_capacity_kwh"]) or not math.isfinite(values["max_charging_power_kw"]) or values["battery_capacity_kwh"] <= 0 or values["max_charging_power_kw"] <= 0:
        return None, "Battery capacity and maximum charging power must be greater than zero"
    return values, None
