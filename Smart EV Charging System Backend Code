@jwt_required()
def list_vehicles():
    user = current_user()
    return jsonify([vehicle_json(item) for item in Vehicle.query.filter_by(owner_id=user.id).order_by(Vehicle.id).all()])
@vehicles_bp.post("")
@jwt_required()
def add_vehicle():
    values, error = _vehicle_values(request.get_json(silent=True) or {})
    if error:
        return jsonify({"error": error}), 400
    vehicle = Vehicle(owner_id=current_user().id, **values)
    db.session.add(vehicle)
    try:
        db.session.commit()
    except Exception as exc:
        db.session.rollback()
        if "unique" in str(exc).lower() or "duplicate" in str(exc).lower():
            return jsonify({"error": "That registration number is already in use"}), 409
        raise
    return jsonify(vehicle_json(vehicle)), 201
@vehicles_bp.patch("/<int:vehicle_id>")
@jwt_required()
def update_vehicle(vehicle_id):
    vehicle = Vehicle.query.filter_by(id=vehicle_id, owner_id=current_user().id).first()
    if vehicle is None:
        return jsonify({"error": "Vehicle not found"}), 404
    values, error = _vehicle_values({**{
        "name": vehicle.name,
        "registration_number": vehicle.registration_number,
        "battery_capacity_kwh": vehicle.battery_capacity_kwh,
        "connector_type": vehicle.connector_type,
        "max_charging_power_kw": vehicle.max_charging_power_kw,
    }, **(request.get_json(silent=True) or {})})
    if error:
        return jsonify({"error": error}), 400
    for key, value in values.items():
        setattr(vehicle, key, value)
    try:
        db.session.commit()
    except Exception as exc:
        db.session.rollback()
        if "unique" in str(exc).lower() or "duplicate" in str(exc).lower():
            return jsonify({"error": "That registration number is already in use"}), 409
        raise
    return jsonify(vehicle_json(vehicle))
@vehicles_bp.delete("/<int:vehicle_id>")
@jwt_required()
def delete_vehicle(vehicle_id):
    vehicle = Vehicle.query.filter_by(id=vehicle_id, owner_id=current_user().id).first()
    if vehicle is None:
        return jsonify({"error": "Vehicle not found"}), 404
    if Booking.query.filter_by(vehicle_id=vehicle.id).first():
        return jsonify({"error": "Cannot delete a vehicle with booking history"}), 409
    db.session.delete(vehicle)
    db.session.commit()
    return "", 204
