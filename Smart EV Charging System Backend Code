@admin_bp.post("/bookings/<int:booking_id>/complete")
@admin_required
def complete_session(booking_id):
    booking = db.session.get(Booking, booking_id)
    if booking is None or booking.status != "charging" or booking.session is None:
        return jsonify({"error": "No active charging session exists for this booking"}), 409
    data = request.get_json(silent=True) or {}
    try:
        energy = float(data.get("energy_kwh", booking.estimated_energy_kwh))
    except (TypeError, ValueError):
        return jsonify({"error": "energy_kwh must be numeric"}), 400
    if not math.isfinite(energy) or energy < 0:
        return jsonify({"error": "energy_kwh must be a non-negative finite number"}), 400
    maximum = booking.vehicle.battery_capacity_kwh * max(0.0, booking.target_percent - booking.battery_percent) / 100.0
    if energy > maximum * 1.1 + 0.01:
        return jsonify({"error": "Recorded energy is too high for the requested battery range"}), 400
    session = booking.session
    session.ended_at = utcnow()
    session.energy_kwh = energy
    session.cost = energy * booking.charger.price_per_kwh
    session.status = "completed"
    db.session.add(Payment(session=session, amount=session.cost, method="simulated", status="simulation_only"))
    booking.status = "completed"
    charger = booking.charger
    charger.status = "available"
    db.session.flush()
    dispatch_waiting_bookings(booking.station_id)
    db.session.commit()
    return jsonify({"session_id": session.id, "booking_id": booking.id, "status": "completed", "energy_kwh": round(energy, 2), "cost": round(session.cost, 2), "ended_at": session.ended_at.isoformat() + "Z"})
