simulation_bp = Blueprint("simulation", __name__, url_prefix="/api/simulation")
@simulation_bp.post("/what-if")
@admin_required
def what_if():
    data = request.get_json(silent=True) or {}
    try:
        station_id = int(data["station_id"])
    except (KeyError, TypeError, ValueError):
        return jsonify({"error": "station_id is required"}), 400
    arrivals = data.get("arrivals")
    if not isinstance(arrivals, list) or not arrivals or len(arrivals) > 100:
        return jsonify({"error": "arrivals must be a list containing 1 to 100 requests"}), 400
    station = Station.query.filter_by(id=station_id, active=True).first()
    if station is None:
        return jsonify({"error": "Active station not found"}), 404
    now_epoch = int(datetime.now(timezone.utc).timestamp())
    normalized = []
    for index, item in enumerate(arrivals):
        if not isinstance(item, dict):
            return jsonify({"error": f"arrivals[{index}] must be an object"}), 400
        try:
            connector = str(item["connector_type"]).strip()
            capacity = float(item["battery_capacity_kwh"])
            vehicle_power = float(item["max_charging_power_kw"])
            battery = float(item["battery_percent"])
            target = float(item["target_percent"])
            offset = int(item.get("arrival_offset_minutes", index))
        except (KeyError, TypeError, ValueError):
            return jsonify({"error": f"arrivals[{index}] has missing or invalid fields"}), 400
        if not connector or not all(math.isfinite(value) for value in (capacity, vehicle_power, battery, target)) or capacity <= 0 or vehicle_power <= 0 or not (0 <= battery < target <= 100) or offset < 0:
            return jsonify({"error": f"arrivals[{index}] values are outside the allowed range"}), 400
        emergency = item.get("emergency", False)
        if not isinstance(emergency, bool):
            return jsonify({"error": f"arrivals[{index}].emergency must be true or false"}), 400
        normalized.append({
            "id": index + 1,
            "connector_type": connector,
            "battery_capacity_kwh": capacity,
            "vehicle_max_power_kw": vehicle_power,
            "battery_percent": battery,
            "target_percent": target,
            "emergency": emergency,
            "priority": priority_for(battery, emergency),
            "created_at_epoch": now_epoch + offset * 60,
        })
    ordered = sort_requests(normalized)
    charger_models = Charger.query.filter_by(station_id=station.id).order_by(Charger.id).all()
    load_kw = committed_power_kw(station.id)
    results = []
    simulated_chargers = [_charger_candidate(charger, station, load_kw) for charger in charger_models]
    for arrival in ordered:
        need = {
            "connector_type": arrival["connector_type"],
            "battery_percent": arrival["battery_percent"],
            "target_percent": arrival["target_percent"],
            "capacity_kwh": arrival["battery_capacity_kwh"],
            "vehicle_max_power_kw": arrival["vehicle_max_power_kw"],
        }
        for candidate in simulated_chargers:
            candidate["committed_power_kw"] = load_kw
        chosen_index = choose_charger(need, simulated_chargers)
        energy = arrival["battery_capacity_kwh"] * max(0.0, arrival["target_percent"] - arrival["battery_percent"]) / 100.0
        if chosen_index >= 0:
            charger = charger_models[chosen_index]
            power = min(charger.max_power_kw, arrival["vehicle_max_power_kw"])
            minutes = round(energy / power * 60) if power > 0 else 0
            cost = energy * charger.price_per_kwh
            load_kw += charger.max_power_kw
            simulated_chargers[chosen_index]["available"] = False
            simulated_chargers[chosen_index]["status"] = "reserved"
            results.append({
                "arrival_id": arrival["id"],
                "status": "assigned",
                "priority_level": arrival["priority"],
                "suggested_charger": {"id": charger.id, "name": charger.name},
                "estimated_energy_kwh": round(energy, 2),
                "estimated_minutes": minutes,
                "estimated_cost": round(cost, 2),
            })
        else:
            suggestion = _quote_charger(
                SimpleNamespace(
                    connector_type=arrival["connector_type"],
                    battery_capacity_kwh=arrival["battery_capacity_kwh"],
                    max_charging_power_kw=arrival["vehicle_max_power_kw"],
                ),
                arrival["battery_percent"], arrival["target_percent"], simulated_chargers,
            )
            charger = next((item for item in charger_models if suggestion and item.id == suggestion["id"]), None)
            results.append({
                "arrival_id": arrival["id"],
                "status": "waiting",
                "priority_level": arrival["priority"],
                "suggested_charger": {"id": charger.id, "name": charger.name} if charger else None,
                "estimated_energy_kwh": round(energy, 2),
                "estimated_minutes": None,
                "estimated_cost": round(energy * charger.price_per_kwh, 2) if charger else None,
            })
    return jsonify({
        "station_id": station.id,
        "scheduler": "python",
        "dispatch_order": [result["arrival_id"] for result in results],
        "projected_committed_power_kw": round(load_kw, 2),
        "station_max_power_kw": station.max_power_kw,
        "would_exceed_power_limit": load_kw > station.max_power_kw,
        "results": results,
        "note": "This is a snapshot simulation. It does not create bookings or control physical chargers.",
    })
def create_app():
    application = Flask(__name__)
    secret_key = os.getenv("SECRET_KEY", "local-development-only-change-me")
    application.config.update(
        SECRET_KEY=secret_key,
        JWT_SECRET_KEY=os.getenv("JWT_SECRET_KEY", secret_key),
        SQLALCHEMY_DATABASE_URI=os.getenv("DATABASE_URL", "sqlite:///smart_ev.db"),
        SQLALCHEMY_TRACK_MODIFICATIONS=False,
        JWT_ACCESS_TOKEN_EXPIRES=60 * 60 * 12,
    )
    db.init_app(application)
    jwt.init_app(application)
    CORS(application, resources={r"/api/*": {"origins": os.getenv("CORS_ORIGIN", "*")}})
    for blueprint in (auth_bp, vehicles_bp, stations_bp, bookings_bp, sessions_bp, admin_bp, simulation_bp):
        application.register_blueprint(blueprint)
    @application.get("/api/health")
    def health():
        return jsonify({"status": "ok", "service": "smart-ev-charging-api"})
    @application.errorhandler(404)
    def not_found(_error):
        return jsonify({"error": "Resource not found"}), 404
    @application.errorhandler(405)
    def method_not_allowed(_error):
        return jsonify({"error": "Method not allowed"}), 405
    @application.cli.command("init-db")
    def init_db_command():
        with application.app_context():
            db.create_all()
        click.echo("Database tables created.")
    @application.cli.command("create-admin")
    @click.option("--name", prompt=True)
    @click.option("--email", prompt=True)
    @click.password_option()
    def create_admin_command(name, email, password):
        normalized_email = email.strip().lower()
        if User.query.filter_by(email=normalized_email).first():
            raise click.ClickException("An account with that email already exists.")
        user = User(
            name=name.strip(),
            email=normalized_email,
            password_hash=generate_password_hash(password),
            role="admin",
        )
        db.session.add(user)
        db.session.commit()
        click.echo(f"Administrator account created for {normalized_email}.")
    return application
app = create_app()
