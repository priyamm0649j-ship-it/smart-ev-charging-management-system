"""Pure Python scheduling algorithms for the Smart EV backend."""
def sort_requests(requests):
    return sorted(
        requests,
        key=lambda item: (
            -int(item["priority"]),
            float(item["battery_percent"]) if int(item["priority"]) > 0 else 0,
            int(item["created_at_epoch"]),
            int(item["id"]),
        ),
    )
def choose_charger(need, chargers):
    energy_kwh = (
        float(need["capacity_kwh"])
        * max(0.0, float(need["target_percent"]) - float(need["battery_percent"]))
        / 100.0
    )
    eligible = []
    for index, charger in enumerate(chargers):
        if not charger["available"]:
            continue
        if charger["connector_type"].casefold() != need["connector_type"].casefold():
            continue
        station_limit = float(charger["station_max_power_kw"])
        charger_power = float(charger["max_power_kw"])
        committed_power = float(charger["committed_power_kw"])
        if committed_power + charger_power > station_limit:
            continue
        effective_power = min(charger_power, float(need["vehicle_max_power_kw"]))
        if effective_power <= 0:
            continue
        minutes = energy_kwh / effective_power * 60.0
        cost = energy_kwh * float(charger["price_per_kwh"])
        projected_load = (committed_power + charger_power) / max(station_limit, 0.001)
        score = minutes + 2.0 * cost + 15.0 * projected_load
        eligible.append((score, int(charger["id"]), index))
    return min(eligible)[2] if eligible else -1
def current_user():
    identity = get_jwt_identity()
    try:
        return db.session.get(User, int(identity))
    except (TypeError, ValueError):
        return None
def admin_required(view):
    @wraps(view)
    @jwt_required()
    def wrapped(*args, **kwargs):
        user = current_user()
        if user is None or user.role != "admin":
            return jsonify({"error": "Administrator access required"}), 403
        return view(*args, **kwargs)
    return wrapped
